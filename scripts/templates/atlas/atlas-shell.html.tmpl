<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Atlas Frontignan — console territoriale (Phase 0)</title>
<style>
:root{
  --bg:#0d1420; --panel:#121b2b; --panel2:#0f1725; --line:#22304a; --line2:#2c3d5c;
  --tx:#dce7f5; --tx2:#8fa3bd; --oc:#1B7F8C; --oc2:#37b2c3;
  --st-EMPTY:#8a8f98; --st-SHELL:#4a90d9; --st-DATA:#2e9e5b; --st-LIVE:#0fb5b5; --st-SIM:#e08a2e;
  --warn:#e08a2e; --danger:#d9534f;
}
*{box-sizing:border-box; margin:0; padding:0}
html,body{height:100%}
body{background:var(--bg); color:var(--tx); font:14px/1.45 "Segoe UI", system-ui, -apple-system, sans-serif; display:flex; flex-direction:column; overflow:hidden}
button{font:inherit; color:inherit; background:none; border:none; cursor:pointer}
a{color:var(--oc2)}
.small{font-size:12px; color:var(--tx2)}
b{color:#fff}

/* ───────────────────── header ───────────────────── */
header{display:flex; align-items:center; gap:14px; padding:8px 14px; background:var(--panel); border-bottom:1px solid var(--line); flex-wrap:wrap}
.brand{font-weight:800; letter-spacing:.5px; font-size:16px; white-space:nowrap}
.brand span{color:var(--oc2); font-weight:600; font-size:12px; margin-left:8px}
.phase-badge{background:linear-gradient(90deg,#1a4a55,#14313d); border:1px solid var(--oc); color:var(--oc2); font-size:11px; font-weight:700; padding:3px 9px; border-radius:20px; white-space:nowrap}
.loop{display:flex; gap:2px; align-items:center; font-size:11px; color:var(--tx2); flex-wrap:wrap}
.loop i{font-style:normal; color:#3d527a}
.loop b{color:var(--tx); background:var(--panel2); border:1px solid var(--line); padding:2px 8px; border-radius:12px}
#status-legend{display:flex; gap:6px; margin-left:auto; flex-wrap:wrap}
#status-legend .st{font-size:10px; padding:2px 8px; border-radius:10px; border:1px solid; white-space:nowrap}
#tour-btn{background:var(--oc); color:#04141a; font-weight:700; padding:5px 12px; border-radius:6px; font-size:12px}
#tour-btn:hover{background:var(--oc2)}

/* ───────────────────── layout ───────────────────── */
main{flex:1; display:flex; min-height:0}
#rail{width:198px; background:var(--panel); border-right:1px solid var(--line); overflow-y:auto; padding:8px; flex-shrink:0}
#mapwrap{flex:1; position:relative; min-width:0; background:#0a111c}
#map{width:100%; height:100%; display:block}
#side{width:352px; background:var(--panel); border-left:1px solid var(--line); display:flex; flex-direction:column; flex-shrink:0}
#drawer{height:242px; background:var(--panel); border-top:1px solid var(--line); display:flex; flex-direction:column; flex-shrink:0}

/* ───────────────────── rail (modes + overlays) ───────────────────── */
.rail-h{font-size:10px; text-transform:uppercase; letter-spacing:1px; color:var(--tx2); margin:8px 4px 6px}
.mode-btn{display:flex; align-items:center; gap:8px; width:100%; text-align:left; padding:7px 9px; border-radius:7px; border:1px solid transparent; color:var(--tx2); margin-bottom:2px}
.mode-btn:hover{background:var(--panel2); color:var(--tx)}
.mode-btn.on{background:#16303f; border-color:var(--oc); color:#fff}
.mode-btn .ic{font-size:16px; width:20px; text-align:center}
.mode-btn .nm{flex:1; font-size:12.5px; line-height:1.2}
.mode-btn .key{font-size:9px; color:#41557a; border:1px solid var(--line); border-radius:4px; padding:0 4px}
.mode-btn .dot{width:8px; height:8px; border-radius:50%; flex-shrink:0}
.ovl-btn{display:flex; align-items:center; gap:8px; width:100%; text-align:left; padding:5px 9px; border-radius:7px; color:var(--tx2); font-size:12px}
.ovl-btn:hover{background:var(--panel2)}
.ovl-btn.on{background:#33270f; color:#f2c078; border:1px solid #6b5320}

/* ───────────────────── map overlays (UI) ───────────────────── */
#mode-q{position:absolute; top:10px; left:10px; max-width:340px; background:rgba(13,20,32,.88); border:1px solid var(--line2); border-left:3px solid var(--oc); border-radius:8px; padding:8px 12px; backdrop-filter:blur(2px)}
#mode-q h2{font-size:14px; margin-bottom:2px}
#mode-q .q{font-size:12px; color:var(--oc2); font-style:italic}
#mode-q .n{font-size:11px; color:var(--tx2); margin-top:4px}
#legend{position:absolute; top:10px; right:10px; width:250px; max-height:70%; overflow-y:auto; background:rgba(13,20,32,.88); border:1px solid var(--line2); border-radius:8px; padding:8px 10px; backdrop-filter:blur(2px)}
#legend h3{font-size:10px; text-transform:uppercase; letter-spacing:1px; color:var(--tx2); margin-bottom:6px}
#legend .ly{display:flex; justify-content:space-between; gap:8px; font-size:11.5px; padding:2.5px 0; border-bottom:1px dashed #1b2а44; border-bottom:1px dashed #1b2944}
#legend .ly:last-child{border:none}
#map-disc{position:absolute; bottom:8px; right:10px; font-size:10px; color:#5b6f92; background:rgba(13,20,32,.7); padding:3px 8px; border-radius:6px}
#tour-box{position:absolute; bottom:26px; left:50%; transform:translateX(-50%); width:min(560px, 92%); background:rgba(15,26,40,.96); border:1px solid var(--oc); border-radius:10px; padding:12px 16px; box-shadow:0 8px 30px rgba(0,0,0,.5)}
#tour-box h3{color:var(--oc2); font-size:13px; margin-bottom:4px}
#tour-box p{font-size:12.5px}
#tour-box .tb-nav{display:flex; gap:8px; justify-content:flex-end; margin-top:8px}
#tour-box .tb-nav button{background:var(--panel2); border:1px solid var(--line2); border-radius:6px; padding:4px 12px; font-size:12px}
#tour-box .tb-nav button.p{background:var(--oc); color:#04141a; font-weight:700}

/* ───────────────────── side panel ───────────────────── */
.tabs{display:flex; border-bottom:1px solid var(--line); flex-shrink:0}
.tabs button{flex:1; padding:9px 4px; font-size:12px; color:var(--tx2); border-bottom:2px solid transparent}
.tabs button.on{color:#fff; border-bottom-color:var(--oc)}
#side-in, #dr-in{flex:1; overflow-y:auto; padding:12px}
.card{background:var(--panel2); border:1px solid var(--line); border-radius:8px; padding:10px 12px; margin-bottom:10px}
.card h3{font-size:13px; margin-bottom:6px; color:#fff}
.card h4{font-size:12px; margin:8px 0 4px; color:var(--oc2)}
.st{font-size:10px; padding:1.5px 8px; border-radius:10px; border:1px solid; white-space:nowrap; display:inline-block; vertical-align:middle}
.st-EMPTY{color:var(--st-EMPTY); border-color:var(--st-EMPTY)}
.st-SHELL{color:var(--st-SHELL); border-color:var(--st-SHELL)}
.st-DATA{color:var(--st-DATA); border-color:var(--st-DATA)}
.st-LIVE{color:var(--st-LIVE); border-color:var(--st-LIVE)}
.st-SIM{color:var(--st-SIM); border-color:var(--st-SIM)}
.st-ph{font-size:9px; color:var(--warn); border:1px dashed var(--warn); border-radius:8px; padding:1px 6px; white-space:nowrap}
.chips{display:flex; flex-wrap:wrap; gap:5px; margin-top:6px}
.mchip{font-size:10.5px; padding:2px 8px; border-radius:12px; background:var(--panel); border:1px solid var(--line2); color:var(--tx2)}
.mchip:hover{border-color:var(--oc); color:#fff}
.kv{font-size:12px; margin:3px 0; color:var(--tx2)}
.kv b{color:var(--tx)}
.btn2{display:inline-block; background:#1d3a4a; border:1px solid var(--oc); color:var(--oc2); border-radius:6px; padding:4px 10px; font-size:11.5px; font-weight:600; text-decoration:none}
.btn2:hover{background:#255064; color:#fff}
.btn-warn{background:#3a2a10; border-color:var(--warn); color:#f2c078}
.blk{border-left:3px solid var(--st-DATA); background:#0f1f18; border-radius:6px; padding:8px 10px; margin-top:8px; font-size:12px}
.warnbox{border:1px dashed var(--warn); background:#2a1f0e; color:#f2c078; border-radius:8px; padding:10px 12px; font-size:12px; margin:10px 0}

/* modules */
.mod-card{border-left:3px solid; border-radius:8px}
.mod-card .sm{display:flex; justify-content:space-between; gap:6px; font-size:12px; padding:3px 0; border-bottom:1px dashed #1b2944}
.mod-card .sm:last-child{border:none}

/* indicators */
.ind{display:flex; align-items:center; gap:8px; padding:7px 0; border-bottom:1px dashed #1b2944}
.ind:last-child{border:none}
.ind .ic{font-size:16px; width:22px; text-align:center}
.ind .body{flex:1; min-width:0}
.ind .nm{font-size:12.5px; color:#fff}
.ind .val{font-size:12px; font-weight:700}
.ind .val.delta{color:var(--warn)}
.bar{height:5px; background:#1a2537; border-radius:3px; overflow:hidden; margin-top:3px}
.bar i{display:block; height:100%; border-radius:3px}

/* ───────────────────── drawer ───────────────────── */
#tree{display:flex; gap:10px; height:100%}
#tree .cols{display:flex; gap:8px; overflow-x:auto; flex:1; padding-bottom:6px}
.tcol{min-width:172px; width:172px; flex-shrink:0}
.tcol>h4{font-size:11px; margin-bottom:6px; padding-bottom:4px; border-bottom:2px solid}
.act{background:var(--panel2); border:1px solid var(--line); border-radius:7px; padding:6px 8px; margin-bottom:6px; cursor:pointer}
.act:hover{border-color:var(--line2); background:#152134}
.act.sel{border-color:var(--oc); background:#16303f}
.act.insc{border-color:var(--st-DATA); box-shadow:0 0 0 1px var(--st-DATA) inset}
.act .nm{font-size:11.5px; color:#fff; line-height:1.25}
.act .meta{font-size:10px; color:var(--tx2); margin-top:3px; display:flex; gap:6px; flex-wrap:wrap; align-items:center}
.act .pr-missing{color:var(--danger); font-size:9.5px}
#scen{display:flex; gap:12px; height:100%}
#scen .col{flex:1; overflow-y:auto; min-width:0}
.scen-act{display:flex; justify-content:space-between; align-items:center; gap:6px; background:var(--panel2); border:1px solid var(--line); border-radius:7px; padding:6px 9px; margin-bottom:6px; font-size:12px}
.scen-act .rm{color:var(--danger); font-weight:800; padding:0 6px}
.dtab{font-variant-numeric:tabular-nums}
.delta-tbl{width:100%; border-collapse:collapse; font-size:12px}
.delta-tbl td{padding:4px 6px; border-bottom:1px dashed #1b2944}
.delta-tbl .aft{color:var(--warn); font-weight:700}
#phases{display:flex; gap:10px; overflow-x:auto; height:100%}
.ph-card{min-width:225px; width:225px; flex-shrink:0; align-self:flex-start}
.ph-card .state{font-size:10px; font-weight:800; padding:2px 8px; border-radius:10px}
.ph-card .state.livré{background:#12331f; color:var(--st-DATA); border:1px solid var(--st-DATA)}
.ph-card .state.prévu{background:#1c2740; color:var(--st-SHELL); border:1px solid var(--st-SHELL)}
.ph-card ul{margin-left:14px; font-size:11.5px; color:var(--tx2)}
#method{display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px; height:100%; overflow-y:auto}
#method .card{align-self:start}
#method ol{margin-left:16px; font-size:12px; color:var(--tx2)}
#method li{margin:3px 0}
#method table{width:100%; border-collapse:collapse; font-size:11px}
#method td{padding:3px 4px; border-bottom:1px dashed #1b2944; vertical-align:top}

/* ───────────────────── SVG map ───────────────────── */
#map .land{fill:#141d2e}
#map .obj{cursor:pointer}
#map .obj:hover{filter:brightness(1.35)}
#map text{font-family:"Segoe UI",system-ui,sans-serif; pointer-events:none}
.mlbl{fill:#7d93b5; font-size:13px; font-weight:600; letter-spacing:.5px}
.mlbl.big{font-size:15px}
.mlbl.water{fill:#4d7ea8; font-style:italic}
.slbl{fill:#9db3d4; font-size:10.5px}
.zone-base{stroke:#33486b; stroke-width:1}
.ghost{fill:none; stroke:var(--warn); stroke-dasharray:5 4; stroke-width:1.6}
.mk{cursor:pointer}
.mk circle{stroke:#0d1420; stroke-width:1.5}
.mk text{fill:#cfe0f5; font-size:10.5px; paint-order:stroke; stroke:#0d1420; stroke-width:3px; font-weight:600}
.mk:hover circle{filter:brightness(1.4)}
.mk.data circle{animation:pulse 2.5s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.55}}
.mk.ghostm circle{stroke-dasharray:3 2}
.ovl-anim{animation:pulse 1.6s infinite}
::-webkit-scrollbar{width:9px;height:9px} ::-webkit-scrollbar-thumb{background:#26354f;border-radius:5px} ::-webkit-scrollbar-track{background:transparent}

@media (max-width:1100px){
  #side{width:290px} #rail{width:170px}
  #method{grid-template-columns:1fr 1fr}
}
</style>
</head>
<body>

<header>
  <div class="brand">ATLAS FRONTIGNAN<span>console territoriale</span></div>
  <div class="phase-badge">Phase 0 · coquille jouable</div>
  <div class="loop" id="loop"></div>
  <div id="status-legend"></div>
  <button id="tour-btn">▶ Fil rouge : pentes → secours</button>
</header>

<main>
  <!-- ═══════════ lentilles (modes) + overlays ═══════════ -->
  <nav id="rail">
    <div class="rail-h">Lentilles de vue</div>
    <div id="rail-modes"></div>
    <div class="rail-h">Overlays</div>
    <div id="rail-overlays"></div>
    <div class="rail-h">Clavier</div>
    <div class="small" style="padding:0 6px 10px">Touches <b>1–9</b> : changer de lentille. Clic sur un objet : inspecteur.</div>
  </nav>

  <!-- ═══════════ carte ═══════════ -->
  <section id="mapwrap">
    <svg id="map" viewBox="0 0 1000 700" preserveAspectRatio="xMidYMid meet" aria-label="Carte stylisée du territoire de Frontignan">
      <defs>
        <linearGradient id="g-gardiole" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#3d5a48"/><stop offset=".55" stop-color="#2c4437"/><stop offset="1" stop-color="#1e3129"/>
        </linearGradient>
        <radialGradient id="g-etang" cx=".42" cy=".45" r=".75">
          <stop offset="0" stop-color="#1d4d66"/><stop offset="1" stop-color="#123447"/>
        </radialGradient>
      </defs>

      <!-- base géographique (toujours visible) -->
      <g id="base">
        <rect class="land" width="1000" height="700"/>
        <path id="o-mer" class="obj" data-obj="mer" fill="#0e2740" d="M 0,700 L 0,640 C 90,628 170,612 250,590 L 330,558 L 383,525 L 500,560 L 700,600 L 1000,630 L 1000,700 Z"/>
        <path id="o-etang-thau" class="obj" data-obj="etang-thau" fill="url(#g-etang)" stroke="#2e6a8a" stroke-width="1.2"
          d="M 280,465 C 340,447 400,440 460,444 C 520,448 540,458 560,468 C 620,470 660,500 700,520 C 740,522 780,505 830,495 C 890,487 950,482 1000,480 L 1000,630 L 700,600 L 500,560 L 383,525 L 330,558 L 250,590 C 240,560 238,530 244,505 C 250,485 262,472 280,465 Z"/>
        <path id="o-lido" class="obj" data-obj="lido" fill="none" stroke="#c8b083" stroke-width="15" stroke-linecap="round" opacity=".85"
          d="M 252,588 L 330,556 L 383,524 L 500,559 L 700,599 L 1000,629"/>
        <path id="o-commune-limite" class="obj" data-obj="commune-limite" fill="none" stroke="#8fa3bd" stroke-width="1.4" stroke-dasharray="7 5" opacity=".7"
          d="M 248,260 C 340,190 500,178 650,210 C 800,242 920,290 996,333 C 996,357 900,382 800,408 C 720,428 640,452 560,462 C 490,470 425,455 385,470 C 352,486 348,522 362,550 C 374,572 396,580 412,572 C 392,552 384,534 392,522 C 344,515 298,532 270,562 C 254,535 247,490 253,448 C 245,420 243,380 248,340 C 243,305 244,280 248,260 Z"/>
        <g id="map-labels">
          <text class="mlbl big" x="150" y="628" text-anchor="middle">SÈTE ↘</text>
          <text class="mlbl" x="905" y="180" text-anchor="middle">VIC-LA-GARDIOLE →</text>
          <text class="mlbl" x="120" y="240" text-anchor="middle">POUSSAN</text>
          <text class="mlbl" x="150" y="150" text-anchor="middle">MIREVAL</text>
          <text class="mlbl water big" x="520" y="530">ÉTANG DE THAU</text>
          <text class="mlbl water" x="560" y="672">MER MÉDITERRANÉE</text>
          <text class="mlbl" x="700" y="205" text-anchor="middle" transform="rotate(-8 700 205)">MASSIF DE LA GARDIOLE</text>
          <text class="slbl" x="430" y="243" text-anchor="middle" transform="rotate(-4 430 243)">vignoble AOC Muscat</text>
          <text class="slbl" x="330" y="392" text-anchor="middle">centre-ville</text>
          <text class="slbl" x="425" y="432" text-anchor="middle">La Peyrade</text>
          <text class="slbl" x="388" y="510" text-anchor="middle">plage · lido</text>
          <text class="slbl" x="620" y="490" text-anchor="middle">Les Aresquiers</text>
          <text class="slbl" x="298" y="316" text-anchor="middle">quartiers nord</text>
          <text class="slbl" x="908" y="330">D600 · gare →</text>
        </g>
      </g>

      <!-- couches thématiques (visibilité pilotée par JS) -->
      <g id="zones">
        <path id="o-gardiole" class="obj" data-obj="gardiole" fill="url(#g-gardiole)" stroke="#4e7360" stroke-width="1.4" opacity=".92"
          d="M 480,255 C 515,120 690,35 870,85 C 950,110 985,195 1000,255 L 1000,380 C 900,330 800,318 705,328 C 585,340 505,305 480,255 Z"/>
        <path id="o-vignobles-muscat" class="obj" data-obj="vignobles-muscat" fill="#4a5d3a" stroke="#6d8551" stroke-width="1" opacity=".55"
          d="M 335,205 C 400,180 480,195 545,225 C 565,238 562,262 540,270 C 470,285 395,278 348,262 C 325,252 325,218 335,205 Z"/>
        <path id="o-quartiers-nord" class="obj" data-obj="quartiers-nord" fill="#2b3a55" stroke="#48608c" stroke-width="1"
          d="M 295,295 L 388,292 L 392,342 L 298,348 Z"/>
        <path id="o-centre-ville" class="obj" data-obj="centre-ville" fill="#3a3550" stroke="#7d6fae" stroke-width="1.3"
          d="M 300,352 L 372,348 L 382,418 L 302,428 Z"/>
        <path id="o-zi-peyrade" class="obj" data-obj="zi-peyrade" fill="#4a3b2d" stroke="#a08055" stroke-width="1.3"
          d="M 390,405 L 455,398 L 462,452 L 396,460 Z"/>
        <path id="o-plage" class="obj" data-obj="plage" fill="#8a744e" stroke="#d9c08a" stroke-width="1.2" opacity=".8"
          d="M 355,540 L 375,522 L 405,512 L 420,524 L 392,544 Z"/>
        <path id="o-aresquiers" class="obj" data-obj="aresquiers" fill="#2b5245" stroke="#4d8a72" stroke-width="1" opacity=".6"
          d="M 520,458 C 580,440 660,462 715,500 C 665,528 585,520 545,498 C 528,482 512,468 520,458 Z"/>
        <path id="o-zones-humides" class="obj" data-obj="aresquiers" fill="#1f4a52" stroke="#3f8a96" stroke-width="1" stroke-dasharray="4 3" opacity=".55"
          d="M 500,462 C 570,445 670,468 730,505 C 700,535 600,538 545,515 C 518,495 495,478 500,462 Z"/>
        <path id="o-bassin-versant-nord" class="obj ghost" data-obj="bassin-versant-nord" fill="rgba(74,144,217,.05)" stroke="#4a90d9"
          d="M 290,340 C 380,255 540,225 700,270 C 830,305 940,330 995,355 C 900,395 780,405 660,395 C 540,385 440,398 385,425 C 335,425 295,390 290,340 Z"/>
        <path id="o-ppri" class="obj" data-obj="ppri" fill="rgba(46,158,150,.14)" stroke="#2e9e9e" stroke-width="1.3" stroke-dasharray="8 4"
          d="M 255,420 C 320,398 400,405 470,418 C 540,432 570,455 555,478 C 500,505 430,495 370,515 C 315,532 285,528 262,508 C 248,478 246,445 255,420 Z"/>
        <path id="o-submersion-lido" class="obj" data-obj="submersion-lido" fill="none" stroke="rgba(46,158,150,.5)" stroke-width="26" stroke-linecap="round"
          d="M 300,560 L 383,524 L 470,555 L 560,582"/>
        <path id="o-icpe" class="obj" data-obj="icpe" fill="none" stroke="#d9822b" stroke-width="1.6" stroke-dasharray="3 3"
          d="M 395,412 L 452,406 L 458,444 L 400,450 Z"/>
        <g id="o-plu-zones" class="obj" data-obj="plu-zones">
          <path d="M 290,290 L 395,285 L 400,345 L 300,350 Z" fill="rgba(155,89,182,.16)" stroke="#9b59b6" stroke-dasharray="5 3"/>
          <path d="M 340,300 L 392,296 L 396,318 L 344,322 Z" fill="none" stroke="#9b59b6" stroke-dasharray="2 2" opacity=".7"/>
        </g>
      </g>

      <g id="reseaux">
        <g id="o-talwegs" class="obj" data-obj="talwegs" fill="none" stroke="#67c4e0" stroke-width="2" stroke-dasharray="7 4" opacity=".8">
          <path d="M 520,285 C 480,320 445,350 405,372 C 372,390 352,408 342,425"/>
          <path d="M 575,305 C 525,335 475,362 425,388 C 385,405 362,422 352,440"/>
          <path d="M 470,262 C 448,300 420,330 392,356 C 368,376 356,396 350,415"/>
        </g>
        <path id="o-collecteur-principal" class="obj" data-obj="collecteur-principal" fill="none" stroke="#4aa3e0" stroke-width="4" stroke-linecap="round"
          d="M 360,398 C 330,415 305,428 285,442 L 272,451"/>
        <g id="o-collecteurs-secondaires" class="obj" data-obj="collecteurs-secondaires" fill="none" stroke="#3d7ab5" stroke-width="1.6" opacity=".8">
          <path d="M 310,360 L 335,395"/><path d="M 350,355 L 352,395"/>
          <path d="M 372,358 L 365,398"/><path d="M 392,392 L 372,414"/><path d="M 382,415 L 412,434"/>
        </g>
        <g id="o-axes-secours" class="obj" data-obj="axes-secours" fill="none" stroke="#e08a2e" stroke-width="2.6" stroke-dasharray="12 5">
          <path d="M 305,388 C 283,362 278,335 288,308"/>
          <path d="M 355,372 C 420,357 480,344 545,338"/>
        </g>
        <path id="o-d600" class="obj" data-obj="d600" fill="none" stroke="#7d93b5" stroke-width="2.4"
          d="M 998,338 C 800,348 600,355 430,365 C 370,372 335,380 305,390 C 272,405 262,470 264,560"/>
        <path id="o-voie-ferree" class="obj" data-obj="voie-ferree" fill="none" stroke="#5b6f92" stroke-width="2" stroke-dasharray="10 4"
          d="M 998,300 C 800,312 620,320 450,332 C 385,338 335,344 298,354 C 276,368 270,430 272,556"/>
        <path id="o-route-plage" class="obj" data-obj="route-plage" fill="none" stroke="#a89a7c" stroke-width="2"
          d="M 350,415 C 360,440 370,470 378,498 L 382,514"/>
        <path id="o-canal-rhone-sete" class="obj" data-obj="canal-rhone-sete" fill="none" stroke="#3f8a96" stroke-width="2.2"
          d="M 998,475 C 840,488 700,522 600,522 C 520,515 470,480 420,452 C 380,438 330,440 300,455 C 282,482 278,530 280,570"/>
        <path id="o-tvb" class="obj" data-obj="tvb" fill="none" stroke="#5bbf7a" stroke-width="2.2" stroke-dasharray="4 4"
          d="M 620,320 C 600,360 580,400 562,438 L 548,464"/>
      </g>

      <g id="markers"></g>
      <g id="ghosts"></g>
      <g id="overlays-g"></g>
    </svg>

    <div id="mode-q"></div>
    <div id="legend"></div>
    <div id="map-disc">carte stylisée indicative — ni étude hydraulique ni géodésie · statuts des couches → légende</div>
    <div id="tour-box" hidden></div>
  </section>

  <!-- ═══════════ panneau latéral ═══════════ -->
  <aside id="side">
    <div class="tabs" id="side-tabs">
      <button data-t="insp" class="on">🔍 Inspecteur</button>
      <button data-t="mods">🧩 Modules</button>
      <button data-t="inds">📊 Indicateurs</button>
    </div>
    <div id="side-in"></div>
  </aside>
</main>

<!-- ═══════════ tiroir bas ═══════════ -->
<section id="drawer">
  <div class="tabs" id="dr-tabs">
    <button data-t="tree" class="on">🌳 Arbre d'actions</button>
    <button data-t="scen">⚖️ Scénario <span id="scen-n" class="st-ph" style="display:none">0</span></button>
    <button data-t="phases">🚧 Phases</button>
    <button data-t="method">📐 Méthode</button>
  </div>
  <div id="dr-in"></div>
</section>

<script type="application/json" id="spec-data">__ATLAS_SPEC__</script>
<script type="application/json" id="cevenols-data">__CEVENOLS_DATA__</script>
<script type="application/json" id="elnino-data">__ELNINO_DATA__</script>
<script>
'use strict';
/* ═══════════ Atlas Frontignan — coquille Phase 0 ═══════════
   Généré par scripts/build_atlas_assets.py depuis :
   - data/atlas-frontignan/atlas-frontignan-2026.json (spec canonique)
   - data/climat/frontignan-episodes-cevenols/... (zones DATA inondation/secours)
   - data/climat/el-nino-2026/... (watchpoints climat, mode Climat)
   Ne pas éditer à la main. */
const SPEC = JSON.parse(document.getElementById('spec-data').textContent);
const C    = JSON.parse(document.getElementById('cevenols-data').textContent);
const E    = JSON.parse(document.getElementById('elnino-data').textContent);

const $  = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
const esc = s => String(s==null?'':s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

const MODES = SPEC.modes, OBJ = SPEC.map.objects, ACTS = SPEC.actions, INDS = SPEC.indicators, MODS = SPEC.modules, UNITS = SPEC.units;
const objById = Object.fromEntries(OBJ.map(o => [o.id, o]));
const actById = Object.fromEntries(ACTS.map(a => [a.id, a]));
const indById = Object.fromEntries(INDS.map(i => [i.id, i]));
const modById = Object.fromEntries(MODS.map(m => [m.id, m]));
const P = SPEC.map.projection;
const project = (lat, lon) => [ (lon - P.lon_min) / (P.lon_max - P.lon_min) * P.width,
                                (P.lat_max - lat) / (P.lat_max - P.lat_min) * P.height ];
const STC = Object.fromEntries(SPEC.statuses.map(s => [s.id, s.color]));
const chip = st => `<span class="st st-${esc(st)}" title="${esc((SPEC.statuses.find(x=>x.id===st)||{}).meaning||'')}">${esc(st)}</span>`;
const store = { get(k, d){ try{ const v = localStorage.getItem('atlas-'+k); return v==null?d:JSON.parse(v);}catch(e){ return d; } },
                set(k, v){ try{ localStorage.setItem('atlas-'+k, JSON.stringify(v)); }catch(e){} } };

let mode  = store.get('mode', 'territoire');
if (!MODES.some(m => m.id === mode)) mode = 'territoire';
let scen  = store.get('scen', []).filter(id => actById[id]);
let ovl   = new Set(store.get('ovl', []));
let sideTab = 'insp', drTab = 'tree', selAct = null, tourI = -1;

/* ── deltas scénario ── */
function deltas(){
  const d = {};
  scen.forEach(id => actById[id].effects.forEach(e => { d[e.indicator] = (d[e.indicator]||0) + e.delta; }));
  return d;
}
function fmtVal(ind, v){
  if (v == null) return '—';
  return ind.unit === 'M€' ? v.toFixed(1).replace('.',',')+' M€' : String(Math.round(v));
}

/* ═══════════ header ═══════════ */
$('#loop').innerHTML = SPEC.meta.product.loop.map((s,i) => `<b>${esc(s)}</b>${i<4?'<i>→</i>':''}`).join('');
$('#status-legend').innerHTML = SPEC.statuses.map(s =>
  `<span class="st st-${esc(s.id)}" title="${esc(s.meaning)}">${esc(s.id)}</span>`).join('');

/* ═══════════ rail : modes + overlays ═══════════ */
function buildRail(){
  $('#rail-modes').innerHTML = '';
  MODES.forEach((m, i) => {
    const b = document.createElement('button');
    b.className = 'mode-btn' + (m.id===mode?' on':'');
    b.innerHTML = `<span class="ic">${m.icon}</span><span class="nm">${esc(m.name)}</span>` +
      (i<10?`<span class="key">${i===9?'0':i+1}</span>`:'') +
      `<span class="dot" style="background:${STC[m.status]}" title="${esc(m.status)}"></span>`;
    b.onclick = () => setMode(m.id);
    b.dataset.mode = m.id;
    $('#rail-modes').appendChild(b);
  });
  $('#rail-overlays').innerHTML = '';
  SPEC.overlays.forEach(o => {
    const b = document.createElement('button');
    b.className = 'ovl-btn' + (ovl.has(o.id)?' on':'');
    b.innerHTML = `<span>${o.icon}</span><span style="flex:1">${esc(o.name)}</span>${chip(o.status)}`;
    b.title = o.note;
    b.onclick = () => { ovl.has(o.id) ? ovl.delete(o.id) : ovl.add(o.id); store.set('ovl',[...ovl]); buildRail(); renderOverlays(); };
    $('#rail-overlays').appendChild(b);
  });
}

/* ═══════════ changement de lentille ═══════════ */
function setMode(id){
  mode = id; store.set('mode', id); tourSync();
  buildRail();
  $$('.mode-btn').forEach(b => b.classList.toggle('on', b.dataset.mode === id));
  const m = MODES.find(x => x.id === id);
  $('#map').setAttribute('data-mode', id);
  $$('#map .obj').forEach(el => {
    const o = objById[el.getAttribute('data-obj')];
    if (!o) return;
    el.style.display = (o.modes.includes('*') || o.modes.includes(id)) ? '' : 'none';
  });
  $$('#markers .mk').forEach(el => {
    const ms = (el.getAttribute('data-modes')||'').split(',');
    el.style.display = (ms.includes('*') || ms.includes(id)) ? '' : 'none';
  });
  $$('#ghosts .mk').forEach(el => { el.style.display = id === 'scenario' ? '' : 'none'; });
  $('#mode-q').innerHTML = `<h2>${m.icon} ${esc(m.name)} ${chip(m.status)}</h2>` +
    `<div class="q">« ${esc(m.question)} »</div><div class="n">${esc(m.note)}</div>`;
  $('#legend').innerHTML = `<h3>Lentille · couches</h3>` + m.layers.map(l =>
    `<div class="ly"><span>${esc(l.name)}</span>${chip(l.status)}</div>`).join('') +
    `<div class="ly" style="margin-top:6px;border-top:1px solid var(--line);padding-top:6px"><span class="small">scénario actif</span><span class="small">${scen.length} action(s)</span></div>`;
  renderOverlays();
  if (sideTab === 'insp' && !$('#side-in').dataset.pinned) renderInspDefault();
}

/* ═══════════ marqueurs (points) ═══════════ */
const NS = 'http://www.w3.org/2000/svg';
function mk(x, y, color, label, cls, modes, data){
  const g = document.createElementNS(NS, 'g');
  g.setAttribute('class', 'mk ' + (cls||'')); g.setAttribute('transform', `translate(${x},${y})`);
  if (modes) g.setAttribute('data-modes', modes);
  const c = document.createElementNS(NS, 'circle');
  c.setAttribute('r', data ? 7 : 5); c.setAttribute('fill', color);
  g.appendChild(c);
  if (label){
    const t = document.createElementNS(NS, 'text');
    t.setAttribute('x', 10); t.setAttribute('y', 3.5); t.textContent = label;
    g.appendChild(t);
  }
  if (data){ g.setAttribute('data-obj', data); g.setAttribute('class', (g.getAttribute('class')||'') + ' obj'); }
  return g;
}
function buildMarkers(){
  const g = $('#markers'); g.innerHTML = '';
  OBJ.filter(o => o.lat != null).forEach(o => {
    const [x, y] = project(o.lat, o.lon);
    const isData = o.status === 'DATA';
    const m = mk(x, y, STC[o.status], o.name, isData?'data':'', o.modes.join(','), o.id);
    g.appendChild(m);
  });
  /* watchpoints climat (dataset El Niño — locaux au bassin de Thau) */
  E.geo.watchpoints.filter(w => w.category === 'local').forEach(w => {
    let [x, y] = project(w.lat, w.lon);
    const inside = x > 8 && x < 992 && y > 8 && y < 692;
    if (!inside){ x = Math.max(12, Math.min(988, x)); y = Math.max(12, Math.min(688, y)); }
    const m = mk(x, y, STC.DATA, w.name + (inside?'':' (hors cadre)'), 'data', 'climat', null);
    m.title = (w.description||'') + ' — statut : ' + (w.status||'');
    m.addEventListener('click', ev => { ev.stopPropagation(); inspectE(w); });
    g.appendChild(m);
  });
  /* projets fantômes du scénario */
  renderGhosts();
}
function renderGhosts(){
  const g = $('#ghosts'); g.innerHTML = '';
  scen.forEach(id => {
    const a = actById[id]; if (!a.map_preview) return;
    const [x, y] = project(a.map_preview.lat, a.map_preview.lon);
    const m = mk(x, y, 'rgba(224,138,46,.85)', a.map_preview.label, 'ghostm', 'scenario', null);
    m.title = a.name + ' — projet du scénario (placeholder)';
    g.appendChild(m);
  });
}

/* ═══════════ overlays décoratifs ═══════════ */
function renderOverlays(){
  const g = $('#overlays-g'); g.innerHTML = '';
  const T = (x, y, s, cls) => { const t = document.createElementNS(NS,'text');
    t.setAttribute('x',x); t.setAttribute('y',y); t.setAttribute('font-size','30'); t.textContent = s;
    if (cls) t.setAttribute('class', cls); g.appendChild(t); return t; };
  if (ovl.has('meteo')){
    T(600, 150, '🌧️', 'ovl-anim');
    const t = T(600, 175, 'épisode cévenol (décoratif — branchement Météo-France Phase 1)');
    t.setAttribute('font-size','10'); t.setAttribute('fill','#8fa3bd');
  }
  if (ovl.has('alertes')){
    [[348,390],[269,453],[366,475],[383,516]].forEach(([x,y]) => {
      const m = mk(x, y, '#d9534f', null, 'ovl-anim data', '*', null); g.appendChild(m);
    });
    const t = T(20, 40, '📢 alertes PCS (démo)'); t.setAttribute('font-size','11'); t.setAttribute('fill','#e08080');
  }
  if (ovl.has('chantiers')){
    T(300, 445, '🚧');
    const t = T(300, 463, 'reprise collecteur (si action choisie)'); t.setAttribute('font-size','10'); t.setAttribute('fill','#c9a15b');
  }
  if (ovl.has('annotations')){
    T(322, 375, '📌');
    const t = T(322, 393, 'notes locales (démo)'); t.setAttribute('font-size','10'); t.setAttribute('fill','#9db3d4');
  }
}

/* ═══════════ inspecteur ═══════════ */
function renderInspDefault(){
  $('#side-in').dataset.pinned = '';
  $('#side-in').innerHTML = `
    <div class="card"><h3>🔍 Inspecteur</h3>
      <p class="small">Cliquez un objet de la carte, un marqueur, ou une action de l'arbre pour l'inspecter.</p>
      <p class="small" style="margin-top:8px">Les objets <span class="st st-DATA">DATA</span> sont alimentés par les datasets canoniques (cévenols, El Niño) ; les autres sont des coquilles assumées.</p></div>
    <div class="card"><h3>${esc(SPEC.meta.product.metaphor.split(',')[0])}</h3>
      <p class="small">${esc(SPEC.key_message.one_liner)}</p>
      <div class="chips">${MODES.map(m=>`<button class="mchip" data-go="${m.id}">${m.icon} ${esc(m.name)}</button>`).join('')}</div></div>`;
  wireGoChips();
}
function wireGoChips(){
  $$('#side-in [data-go]').forEach(b => b.onclick = () => setMode(b.dataset.go));
}
function relatedActions(objId){ return ACTS.filter(a => a.map_object === objId); }
function bpCards(w){
  const bps = (w.blocking_point_ids||[]).map(id => C.blocking_points.find(b => b.id === id)).filter(Boolean);
  if (!bps.length) return '';
  return bps.map(bp => `
    <div class="blk"><b>⛔ Blocage documenté — ${esc(bp.title)}</b>
      <div class="kv"><b>Mécanisme :</b> ${esc(bp.mechanism)}</div>
      <div class="kv"><b>Preuve :</b> ${esc(bp.evidence)}</div>
      <div class="kv"><b>Verrou :</b> ${esc(bp.blockage)}</div>
      <div class="kv">${bp.simulable ? `<a class="btn2" href="el-nino-thau.html#sim">→ Simuler ce mécanisme (module climat)</a>` : '<span class="small">non simulable simplement</span>'}</div>
    </div>`).join('');
}
function inspect(obj){
  const dl = obj.data_link;
  const w = dl ? (C.geo.watchpoints.find(x => x.id === dl.watchpoint) || null) : null;
  const unit = UNITS.find(u => u.id === obj.kind);
  const rel = relatedActions(obj.id);
  $('#side-in').dataset.pinned = '1';
  $('#side-in').innerHTML = `
    <div class="card"><h3>${esc(obj.name)}</h3>
      <div class="chips" style="margin:2px 0 8px">${chip(obj.status)} <span class="mchip">${esc(unit?unit.name:obj.kind)}</span></div>
      <p class="small" style="color:var(--tx)">${esc(obj.desc)}</p>
      ${w ? `<div class="blk"><b>📍 ${esc(w.name)}</b> <span class="small">(zone du dataset cévenols)</span></div>${bpCards(w)}` : ''}
      <h4>Où le voir</h4>
      <div class="chips">${obj.modes.map(mid => { const m = MODES.find(x=>x.id===mid);
        return mid==='*' ? `<button class="mchip" data-go="territoire">🗺️ toutes les lentilles</button>` :
        `<button class="mchip" data-go="${m.id}">${m.icon} ${esc(m.name)}</button>`; }).join('')}</div>
      ${rel.length ? `<h4>Actions liées (${rel.length})</h4>` + rel.map(a => actRow(a)).join('') : ''}
    </div>`;
  wireGoChips(); wireActRows();
}
function inspectE(w){
  $('#side-in').dataset.pinned = '1';
  $('#side-in').innerHTML = `
    <div class="card"><h3>🌡️ ${esc(w.name)}</h3>
      <div class="chips" style="margin:2px 0 8px">${chip('DATA')} <span class="mchip">watchpoint climat</span></div>
      <p class="small" style="color:var(--tx)">${esc(w.description)}</p>
      <div class="kv" style="margin-top:6px"><b>Statut :</b> ${esc(w.status)}</div>
      <div style="margin-top:8px"><a class="btn2" href="el-nino-thau.html">→ Module climat « Atlas Frontignan » (9 onglets)</a></div>
    </div>`;
}
function actRow(a){
  const inScen = scen.includes(a.id);
  const missing = a.prereqs.filter(p => !scen.includes(p));
  return `<div class="kv" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
    <span>${esc(a.name)}</span>
    ${missing.length?`<span class="pr-missing">prérequis : ${esc(missing.join(', '))}</span>`:''}
    <button class="btn2 ${inScen?'':'btn-warn'}" data-act="${a.id}">${inScen?'✓ dans le scénario':'+ scénario'}</button></div>`;
}
function wireActRows(){
  $$('#side-in [data-act]').forEach(b => b.onclick = () => toggleAct(b.dataset.act));
}

/* ═══════════ panneau modules ═══════════ */
function renderMods(){
  const papi = C.solutions && C.solutions.papi;
  $('#side-in').innerHTML = MODS.map(m => `
    <div class="card mod-card" style="border-left-color:${esc(m.color)}">
      <h3>${m.icon} ${esc(m.name)} ${chip(m.status)}</h3>
      ${m.submodules.map(sm => {
        let extra = '';
        if (sm.id === 'budgets' && papi) extra = `<div class="blk" style="margin-top:4px"><b>💰 ${esc(papi.name)}</b>
          <div class="kv">${esc(papi.actions)} actions · ${esc(papi.communes)} communes · ≈${esc(String(papi.budget_millions)).replace('.',',')} M€ <span class="small">(${esc(papi.status||'labellisé avril 2026')})</span></div>
          <div class="kv small">${esc(papi.point_a_verifier||'')}</div></div>`;
        if (sm.id === 'inondation-ruissellement') extra = `<div style="margin-top:4px"><button class="btn2" data-go="inondation">→ voir les zones de blocage</button></div>`;
        return `<div class="sm"><span>${esc(sm.name)}</span>${chip(sm.status)}</div>${extra}`;
      }).join('')}
      <div class="chips">${(m.modes||[]).map(mid => { const mm = MODES.find(x=>x.id===mid);
        return `<button class="mchip" data-go="${mid}">${mm.icon} ${esc(mm.name)}</button>`; }).join('')}</div>
    </div>`).join('');
  wireGoChips();
}

/* ═══════════ panneau indicateurs ═══════════ */
function renderInds(){
  const d = deltas();
  $('#side-in').innerHTML = `<div class="card"><h3>📊 Indicateurs (yields)</h3>
    <p class="small">Valeurs de départ marquées « placeholder » = démonstration, pas des estimations. Seul le budget PAPI est documenté.</p></div>` +
    INDS.map(ind => {
      const dl = d[ind.id] || 0;
      const cur = ind.baseline == null ? null : ind.baseline + dl;
      const pct = ind.baseline == null ? 0 : Math.max(4, Math.min(100, ind.baseline));
      const pct2 = cur == null ? 0 : Math.max(4, Math.min(100, cur));
      return `<div class="ind">
        <span class="ic">${ind.icon}</span>
        <div class="body">
          <div class="nm">${esc(ind.name)} <span class="small">(${esc(ind.unit)} · ${ind.direction==='lower'?'↓ mieux':'↑ mieux'})</span></div>
          <div class="small">${esc(ind.note)}</div>
          <div class="bar"><i style="width:${pct}%;background:${STC[ind.status]}"></i></div>
          ${dl ? `<div class="bar"><i style="width:${pct2}%;background:${STC.SIM}"></i></div>` : ''}
        </div>
        <div style="text-align:right">
          <div class="val ${dl?'delta':''}">${fmtVal(ind, ind.baseline)}${dl ? ' → ' + fmtVal(ind, cur) : ''}</div>
          ${chip(ind.status)}${dl ? `<div class="st-ph" style="margin-top:4px">placeholder</div>` : ''}
        </div></div>`;
    }).join('') +
    `<div class="warnbox"><b>Vigilance :</b> ${esc(SPEC.key_message.vigilance)}</div>`;
}

/* ═══════════ tiroir : arbre d'actions ═══════════ */
function renderTree(){
  const sel = selAct ? actById[selAct] : null;
  const detail = sel ? `
    <div style="width:330px;flex-shrink:0;overflow-y:auto">
      <div class="card"><h3>${esc(sel.name)}</h3>
        <div class="chips" style="margin:2px 0 8px">${chip(sel.status)} <span class="mchip">${esc((modById[sel.module]||{}).name||'')}</span></div>
        <div class="kv"><b>Coût :</b> ${esc(sel.cost)} <span class="st-ph">placeholder</span></div>
        <div class="kv"><b>Délai :</b> ${esc(sel.delay)}</div>
        ${sel.prereqs.length ? `<div class="kv"><b>Prérequis :</b> ${sel.prereqs.map(p => actById[p] ? esc(actById[p].name) : esc(p)).join(' · ')}</div>` : ''}
        <h4>Effets (multi-modules)</h4>
        ${sel.effects.map(e => { const i = indById[e.indicator];
          return `<div class="kv">${i.icon} ${esc(i.name)} : <b style="color:${e.delta>0===(i.direction==='higher')?'#2e9e5b':'#d9534f'}">${e.delta>0?'+':''}${e.delta}</b> <span class="st-ph">${esc(e.basis)}</span></div>`; }).join('')}
        ${sel.sim_hook ? `<div class="kv"><b>Hook simulation :</b> <span class="small">${esc(sel.sim_hook)}</span></div>` : ''}
        ${sel.note ? `<div class="kv"><b>Note :</b> <span class="small">${esc(sel.note)}</span></div>` : ''}
        <div style="margin-top:10px;display:flex;gap:8px;align-items:center;flex-wrap:wrap">
          <button class="btn2 ${scen.includes(sel.id)?'':'btn-warn'}" data-act="${sel.id}">${scen.includes(sel.id)?'✓ retirer du scénario':'+ ajouter au scénario'}</button>
          ${sel.prereqs.filter(p=>!scen.includes(p)).length ? `<span class="pr-missing">prérequis manquant : ${esc(sel.prereqs.filter(p=>!scen.includes(p)).join(', '))}</span>` : ''}
        </div>
      </div>
    </div>` : `
    <div style="width:330px;flex-shrink:0"><div class="card"><h3>🌳 Arbre d'actions</h3>
      <p class="small">Chaque action = coût, délai, prérequis, effets multi-modules, preview carte, hook de simulation.</p>
      <p class="small" style="margin-top:6px">Coûts et effets sont des <span class="st-ph">placeholders</span> — cliquez une action pour le détail.</p>
      <div class="kv" style="margin-top:8px"><b>${ACTS.length}</b> actions · <b>${MODS.length}</b> branches</div>
      <div class="kv"><b>Fil d'actualité :</b> <span class="small">l'onglet Scénario cumule les effets et dessine les projets « fantômes » sur la carte.</span></div>
    </div></div>`;
  $('#dr-in').innerHTML = `<div id="tree">${detail}
    <div class="cols">${MODS.map(m => `
      <div class="tcol"><h4 style="border-color:${esc(m.color)}">${m.icon} ${esc(m.name)} ${chip(m.status)}</h4>
        ${ACTS.filter(a => a.module === m.id).map(a => {
          const missing = a.prereqs.filter(p => !scen.includes(p));
          return `<div class="act ${selAct===a.id?'sel':''} ${scen.includes(a.id)?'insc':''}" data-sel="${a.id}">
            <div class="nm">${scen.includes(a.id)?'✓ ':''}${esc(a.name)}</div>
            <div class="meta"><span>${esc(a.cost)}</span><span>·</span><span>${esc(a.delay)}</span>
              ${missing.length?`<span class="pr-missing">⚠ préreq.</span>`:''}</div>
          </div>`; }).join('')}
      </div>`).join('')}</div></div>`;
  $$('#tree .act').forEach(el => el.onclick = () => { selAct = el.dataset.sel; renderTree();
    const a = actById[selAct]; const o = a.map_object && objById[a.map_object];
    if (o) inspect(o); });
  $$('#tree [data-act]').forEach(b => b.onclick = ev => { ev.stopPropagation(); toggleAct(b.dataset.act); });
}

/* ═══════════ tiroir : scénario ═══════════ */
function renderScen(){
  const d = deltas();
  const n = scen.length;
  $('#scen-n').style.display = n ? '' : 'none';
  $('#scen-n').textContent = n;
  $('#dr-in').innerHTML = `<div id="scen">
    <div class="col">
      <div class="card"><h3>⚖️ Actions choisies (${n})</h3>
        ${n ? scen.map(id => `<div class="scen-act"><span>${esc(actById[id].name)}</span><button class="rm" data-rm="${id}" title="retirer">✕</button></div>`).join('')
             : '<p class="small">Aucune action. Choisissez dans l\'arbre → elles s\'ajoutent ici, dessinent des projets « fantômes » sur la carte (lentille Scénario) et font bouger les indicateurs.</p>'}
        ${n ? `<div style="margin-top:8px;display:flex;gap:8px"><button class="btn2" data-go="scenario">→ voir sur la carte</button><button class="btn2 btn-warn" data-reset>vider le scénario</button></div>` : ''}
      </div>
      <div class="card"><h4>Prérequis non satisfaits</h4>
        ${(() => { const miss = [];
          scen.forEach(id => actById[id].prereqs.filter(p => !scen.includes(p)).forEach(p => miss.push(actById[p].name + ' ← ' + actById[id].name)));
          return miss.length ? miss.map(m2 => `<div class="kv">⚠ ${esc(m2)}</div>`).join('') : '<p class="small">aucun</p>'; })()}
      </div>
    </div>
    <div class="col">
      <div class="card"><h3>Avant / après (indicateurs)</h3>
        <table class="delta-tbl dtab"><tr><th style="text-align:left">Indicateur</th><th>avant</th><th>après</th><th>Δ</th></tr>
        ${INDS.filter(i => d[i.id]).map(i => `<tr><td>${i.icon} ${esc(i.name)}</td>
          <td class="dtab">${fmtVal(i, i.baseline)}</td><td class="aft dtab">${fmtVal(i, i.baseline==null?null:i.baseline+d[i.id])}</td>
          <td class="dtab">${d[i.id]>0?'+':''}${Math.round(d[i.id]*10)/10}</td></tr>`).join('')}
        ${Object.keys(d).length ? '' : '<tr><td colspan="4" class="small">choisissez des actions pour voir les deltas</td></tr>'}
        </table>
      </div>
      <div class="warnbox"><b>⚠️ Tous ces chiffres sont des placeholders de démonstration.</b><br>
        Aucun n'est une estimation fiable : ni les coûts, ni les effets, ni les « avant/après ».
        Les simulations vérifiables arrivent en Phase 3 (moteurs fondés, ex. piste open source LISEM).
        ${esc(SPEC.meta.disclaimer.split('.')[1]||'')}</div>
    </div></div>`;
  $$('#scen [data-rm]').forEach(b => b.onclick = () => toggleAct(b.dataset.rm));
  $$('#scen [data-go]').forEach(b => b.onclick = () => setMode(b.dataset.go));
  const rs = $('#scen [data-reset]'); if (rs) rs.onclick = () => { scen = []; store.set('scen', scen); refreshScen(); };
}
function toggleAct(id){
  if (scen.includes(id)) scen = scen.filter(x => x !== id); else scen.push(id);
  store.set('scen', scen);
  refreshScen();
}
function refreshScen(){
  renderGhosts(); renderScen(); renderTree(); renderInds();
  const m = MODES.find(x => x.id === mode);
  $('#legend').innerHTML = `<h3>Lentille · couches</h3>` + m.layers.map(l =>
    `<div class="ly"><span>${esc(l.name)}</span>${chip(l.status)}</div>`).join('') +
    `<div class="ly" style="margin-top:6px;border-top:1px solid var(--line);padding-top:6px"><span class="small">scénario actif</span><span class="small">${scen.length} action(s)</span></div>`;
}

/* ═══════════ tiroir : phases ═══════════ */
function renderPhases(){
  $('#dr-in').innerHTML = `<div id="phases">` + SPEC.phases.map(p => `
    <div class="card ph-card"><h3>${esc(p.name)}</h3>
      <div style="margin:4px 0 6px"><span class="state ${esc(p.state)}">${esc(p.state.toUpperCase())}</span></div>
      <p class="small" style="color:var(--tx)">${esc(p.goal)}</p>
      <ul style="margin-top:6px">${p.deliverables.map(d2 => `<li>${esc(d2)}</li>`).join('')}</ul>
    </div>`).join('') + `</div>`;
}

/* ═══════════ tiroir : méthode ═══════════ */
function renderMethod(){
  const nObjD = OBJ.filter(o => o.status === 'DATA').length;
  $('#dr-in').innerHTML = `<div id="method">
    <div class="card"><h3>📐 Méthode de construction</h3>
      <ol>${SPEC.key_message.method_steps.map(s => `<li>${esc(s)}</li>`).join('')}</ol>
      <h4>Boucle de jeu</h4>
      <div class="chips">${SPEC.meta.product.loop.map(l => `<span class="mchip">${esc(l)}</span>`).join('')}</div>
      <h4>Fil rouge (l'exemple prioritaire, pas le projet)</h4>
      <p class="small">${esc(SPEC.key_message.fil_rouge)}</p>
      <h4>Ce qu'Atlas n'est pas</h4>
      <p class="small">${esc(SPEC.meta.product.not_a)}</p>
      <h4>Public</h4>
      <p class="small">${esc(SPEC.meta.product.audience)}</p>
    </div>
    <div class="card"><h3>🚦 Statuts — la règle du jeu</h3>
      <table>${SPEC.statuses.map(s => `<tr><td><span class="st st-${esc(s.id)}">${esc(s.id)}</span></td><td class="small">${esc(s.meaning)}</td></tr>`).join('')}</table>
      <div class="warnbox"><b>Point de vigilance essentiel</b><br>${esc(SPEC.key_message.vigilance)}</div>
      <h4>Unités cartographiées</h4>
      <table>${UNITS.map(u => `<tr><td><b>${esc(u.name)}</b></td><td class="small">${esc(u.desc)}</td></tr>`).join('')}</table>
    </div>
    <div class="card"><h3>🔌 Données & réutilisation (monorepo)</h3>
      <div class="kv"><b>Spec canonique :</b> <span class="small">data/atlas-frontignan/atlas-frontignan-2026.json (${esc(SPEC.meta.version)}, as_of ${esc(SPEC.meta.as_of)})</span></div>
      <div class="kv"><b>Objets carte :</b> <span class="small">${OBJ.length} (${nObjD} DATA via datasets climat)</span></div>
      <div class="kv"><b>Contenu :</b> <span class="small">${MODES.length} modes · ${MODS.length} modules (${MODS.reduce((a,m)=>a+m.submodules.length,0)} sous-modules) · ${ACTS.length} actions · ${INDS.length} indicateurs</span></div>
      ${SPEC.links.map(l => `<div class="kv">→ ${l.url ? `<a href="${esc(l.url)}${l.hash?esc(l.hash):''}">${esc(l.label)}</a>` : `<b>${esc(l.label)}</b>`} <span class="small">${esc(l.note||'')} ${l.path?esc(l.path):''}</span></div>`).join('')}
      <div class="kv"><b>Artefact généré</b> <span class="small">— ne pas éditer à la main : python3 scripts/build_atlas_assets.py</span></div>
      <h4>Sources de données (remplissage)</h4>
      ${SPEC.data_sources.map(s => `<div class="kv"><span class="st st-${esc(s.status)}">${esc(s.status)}</span> <b>${esc(s.name)}</b> <span class="small">— ${esc(s.scope)} · ${esc(s.phase)}</span></div>`).join('')}
      <h4>Synthèses fondatrices</h4>
      ${SPEC.sources.filter(s => s.id.startsWith('s-synth')).map(s => `<div class="kv small">• ${esc(s.title)} (${esc(s.date)}) — ${esc(s.note)}</div>`).join('')}
    </div>
  </div>`;
}

/* ═══════════ fil rouge (visite guidée) ═══════════ */
const TOUR = [
  { mode:'relief',     t:'1/5 · D\'où vient l\'eau ?',        p:'Le massif de la Gardiole domine la ville : ses pentes concentrent les écoulements vers les points bas (talwegs en pointillés bleus).' },
  { mode:'pluvial',    t:'2/5 · Où passe-t-elle ?',           p:'Talwegs et collecteurs canalisent la pluie vers les exutoires de l\'étang de Thau. Le réseau est dimensionné pour la pluie normale — pas pour l\'épisode cévenol (désordres SMBT, sollicitation des réseaux début 2026).' },
  { mode:'inondation', t:'3/5 · Quand ça déborde ?',           p:'Cinq blocages documentés (dataset cévenols, statut DATA) : Gardiole→centre-ville, saturation des réseaux, littoral/étang, déplacements & secours, pollutions secondaires. Cliquez les zones vertes.' },
  { mode:'secours',    t:'4/5 · Qui agit ?',                   p:'PCS 2025, équipes mobiles, axes d\'évacuation : délais d\'alerte courts, quartiers isolables, saisonnalité (campings). Le nerf de la crise.' },
  { mode:'scenario',   t:'5/5 · Et si on agissait ?',          p:'Choisissez des actions dans l\'arbre (en bas) et comparez avant/après. ⚠ Placeholders assumés jusqu\'aux simulations fondées de la Phase 3.' }
];
function tourGo(i){
  tourI = i;
  const box = $('#tour-box');
  if (i < 0 || i >= TOUR.length){ box.hidden = true; return; }
  box.hidden = false;
  const s = TOUR[i];
  setMode(s.mode);
  box.innerHTML = `<h3>${esc(s.t)}</h3><p>${esc(s.p)}</p>
    <div class="tb-nav"><button data-ti="-1">✕ quitter</button>
    <button data-ti="${i-1}" ${i===0?'disabled':''}>← précédent</button>
    <button class="p" data-ti="${i+1}">${i===TOUR.length-1?'finir ✕':'suivant →'}</button></div>`;
  $$('#tour-box [data-ti]').forEach(b => b.onclick = () => tourGo(+b.dataset.ti >= TOUR.length || +b.dataset.ti < 0 ? -1 : +b.dataset.ti));
}
function tourSync(){ /* le fil rouge pilote la lentille : rien à faire d'autre */ }
$('#tour-btn').onclick = () => tourGo(0);

/* ═══════════ onglets latéraux & tiroir ═══════════ */
function setSideTab(t){
  sideTab = t;
  $$('#side-tabs button').forEach(b => b.classList.toggle('on', b.dataset.t === t));
  if (t === 'insp') renderInspDefault();
  if (t === 'mods') renderMods();
  if (t === 'inds') renderInds();
}
$$('#side-tabs button').forEach(b => b.onclick = () => setSideTab(b.dataset.t));
function setDrTab(t){
  drTab = t;
  $$('#dr-tabs button').forEach(b => b.classList.toggle('on', b.dataset.t === t));
  if (t === 'tree') renderTree();
  if (t === 'scen') renderScen();
  if (t === 'phases') renderPhases();
  if (t === 'method') renderMethod();
}
$$('#dr-tabs button').forEach(b => b.onclick = () => setDrTab(b.dataset.t));

/* ═══════════ interactions carte ═══════════ */
$('#map').addEventListener('click', e => {
  const el = e.target.closest('[data-obj]');
  if (!el) return;
  const o = objById[el.getAttribute('data-obj')];
  if (o){ setSideTab('insp'); inspect(o); }
});
document.addEventListener('keydown', e => {
  if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
  if (e.key >= '1' && e.key <= '9'){ const i = +e.key - 1; if (i < MODES.length) setMode(MODES[i].id); }
  else if (e.key === '0'){ if (MODES.length > 9) setMode(MODES[9].id); }
});

/* ═══════════ démarrage ═══════════ */
buildRail();
buildMarkers();
setMode(mode);
setSideTab('insp');
setDrTab('tree');
</script>
</body>
</html>
