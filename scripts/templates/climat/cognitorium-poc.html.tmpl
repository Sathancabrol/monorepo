<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Cognitorium — PoC El Niño : du Pacifique au bassin de Thau</title>
<meta name="description" content="Parcours d'apprentissage par résolution progressive de problèmes : comprendre El Niño 2026–2027, l'attribution, le RONI, le réchauffement de fond et la préparation du bassin de Thau.">
<!--
  ╔══════════════════════════════════════════════════════════════════════╗
  ║ GÉNÉRÉ — ne pas éditer à la main.                                    ║
  ║ Source de vérité : data/climat/el-nino-2026/el-nino-godzilla-2026.json║
  ║ Template         : scripts/templates/climat/cognitorium-poc.html.tmpl ║
  ║ Régénérer        : python3 scripts/build_climat_assets.py            ║
  ╚══════════════════════════════════════════════════════════════════════╝
-->
<style>
:root{--bg:#0a0e1a;--bg2:#0d1424;--card:#111a2e;--line:#1e2c4a;--txt:#dde7f8;--mut:#8aa0c8;--dim:#5d7199;
--oc:#35c4e8;--gold:#ffc857;--green:#3ddc97;--hot:#ff6b4a}
*{box-sizing:border-box;margin:0;padding:0}
body{background:radial-gradient(900px 500px at 85% -10%,#10305a44,transparent),linear-gradient(180deg,var(--bg),var(--bg2));color:var(--txt);font-family:'Segoe UI',system-ui,-apple-system,Roboto,Arial,sans-serif;line-height:1.6;min-height:100vh}
.wrap{max-width:1080px;margin:0 auto;padding:34px 18px 90px}
header{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;flex-wrap:wrap;margin-bottom:22px}
small.eyebrow{letter-spacing:3px;text-transform:uppercase;font-size:11px;color:var(--oc);font-weight:700}
h1{font-size:clamp(24px,4vw,38px);line-height:1.1;margin:8px 0;background:linear-gradient(90deg,#fff,var(--oc) 55%,var(--gold));-webkit-background-clip:text;background-clip:text;color:transparent}
.subtitle{color:var(--mut);font-size:15px}
.progress{font-size:14px;color:var(--gold);font-weight:700;white-space:nowrap;border:1px solid var(--line);background:var(--card);padding:8px 14px;border-radius:999px}
.layout{display:grid;grid-template-columns:1.6fr 1fr;gap:16px;align-items:start}
@media(max-width:820px){.layout{grid-template-columns:1fr}}
.card{background:linear-gradient(180deg,var(--card),#0e1626);border:1px solid var(--line);border-radius:16px;padding:22px}
.card+.card{margin-top:16px}
.eyebrow{letter-spacing:2px;text-transform:uppercase;font-size:11px;color:var(--oc);font-weight:700;margin-bottom:8px}
h2{font-size:21px;color:#fff;margin-bottom:12px}
#situation{color:var(--mut);font-size:15px;margin-bottom:12px}
.problem{background:#0c1526;border:1px solid var(--line);border-left:3px solid var(--gold);border-radius:0 12px 12px 0;padding:14px 16px;font-size:15px;margin-bottom:16px}
.choices{display:flex;flex-direction:column;gap:9px}
.choices button{text-align:left;padding:13px 16px;border-radius:12px;border:1px solid var(--line);background:#0e1a34;color:var(--txt);font-size:14.5px;cursor:pointer;transition:.15s;line-height:1.45}
.choices button:hover:not(:disabled){border-color:var(--oc);transform:translateX(3px)}
.choices button:disabled{opacity:.75;cursor:default}
.choices button.good{border-color:var(--green);background:#3ddc9714;opacity:1}
.choices button.bad{border-color:var(--hot);background:#ff6b4a14;opacity:1}
.graph-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:10px}
.graph-head h3{font-size:15px;color:#fff}
.graph-count{font-size:12px;color:var(--gold);font-weight:700}
.graph-status{font-size:11px;color:var(--dim);display:block;margin-top:2px}
.graph-canvas{display:flex;flex-wrap:wrap;gap:7px;min-height:90px}
.node{font-size:12px;border:1px dashed var(--line);color:var(--dim);border-radius:999px;padding:4px 11px;animation:pop .4s ease both}
.node.discovered{border-style:solid;color:var(--txt);border-color:#2a6fdb88;background:#12233f}
.node.active{border-color:var(--gold);color:var(--gold);box-shadow:0 0 0 3px #ffc85722}
.node small{display:block;font-size:9.5px;color:var(--dim);text-align:center}
@keyframes pop{from{opacity:0;transform:scale(.7)}to{opacity:1;transform:scale(1)}}
.legend{display:flex;gap:14px;font-size:11px;color:var(--dim);margin-top:10px}
.legend .new{display:inline-block;width:9px;height:9px;background:#2a6fdb;border-radius:50%;margin-right:4px}
.legend .known{display:inline-block;width:9px;height:9px;border:1px dashed var(--dim);border-radius:50%;margin-right:4px}
.hidden{display:none}
.feedback{border-color:#2a6fdb66}
.feedback-top{display:flex;justify-content:space-between;gap:14px;align-items:center;flex-wrap:wrap;margin-bottom:14px}
.comprehension{display:flex;align-items:center;gap:12px}
.comprehension-ring{--score:0%;width:64px;height:64px;border-radius:50%;background:conic-gradient(var(--oc) var(--score),#16233f 0);display:flex;align-items:center;justify-content:center;position:relative;flex:none}
.comprehension-ring::before{content:'';position:absolute;inset:7px;background:var(--card);border-radius:50%}
.comprehension-ring span{position:relative;font-size:17px;font-weight:800;color:var(--oc)}
.comprehension strong{font-size:13px;display:block;color:#fff}
.comprehension small{font-size:11.5px;color:var(--mut)}
.answer-reveal{background:#0c1526;border:1px solid var(--line);border-radius:12px;padding:14px 16px;margin-bottom:14px}
.answer-label{font-size:10px;letter-spacing:2px;color:var(--dim);margin-bottom:6px}
.answer-choice{font-weight:700;color:var(--gold);font-size:15px}
.answer-correct{font-size:13.5px;color:var(--mut);margin-top:6px}
.concepts{margin:14px 0}
.concepts strong{font-size:12px;letter-spacing:1px;color:var(--mut);text-transform:uppercase}
.concept{display:inline-block;background:#12233f;border:1px solid #2a6fdb66;color:var(--txt);border-radius:999px;padding:4px 12px;font-size:12.5px;margin:5px 4px 0 0;animation:pop .4s ease both}
.connection-stage{display:grid;grid-template-columns:1fr 40px 1fr;gap:8px;align-items:center;margin:16px 0}
.connection-line{height:2px;background:linear-gradient(90deg,var(--oc),var(--gold))}
.pop-label{font-size:10px;letter-spacing:1.5px;color:var(--dim);text-transform:uppercase;display:block;margin-bottom:4px}
.connection-pop span:last-child{font-size:13px;color:var(--txt);display:block}
.continue{width:100%;padding:13px;border:none;border-radius:12px;background:linear-gradient(90deg,var(--oc),#2a6fdb);color:#fff;font-size:15px;font-weight:700;cursor:pointer}
.continue:hover{filter:brightness(1.12)}
.assessment textarea{width:100%;min-height:110px;background:#0c1526;border:1px solid var(--line);border-radius:12px;color:var(--txt);padding:12px;font-family:inherit;font-size:14px;resize:vertical;margin:10px 0}
.assessment button{padding:12px 22px;border:none;border-radius:12px;background:linear-gradient(90deg,var(--gold),#e09e2a);color:#1a1400;font-weight:700;font-size:14px;cursor:pointer}
.result{margin-top:14px;font-size:14px;color:var(--mut)}
.result strong{color:var(--gold)}
footer{margin-top:26px;color:var(--dim);font-size:12px;text-align:center}
footer a{color:var(--oc)}
.src{font-size:11.5px;color:var(--dim);margin-top:10px}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div>
      <small class="eyebrow">Cognitorium Learning Engine · PoC Climat</small>
      <h1 id="poc-title"></h1>
      <p class="subtitle" id="poc-subtitle"></p>
    </div>
    <div class="progress" id="progress">0 %</div>
  </header>

  <section class="layout">
    <article class="card scenario">
      <div class="eyebrow" id="level"></div>
      <h2 id="title"></h2>
      <p id="situation"></p>
      <div class="problem" id="problem"></div>
      <div id="choices" class="choices"></div>
      <p class="src" id="level-src"></p>
    </article>

    <aside class="card graph">
      <div class="graph-head">
        <div>
          <h3>Concept Graph</h3>
          <span id="graphCount" class="graph-count">0 concepts</span>
          <span class="graph-status">construction en direct — du Pacifique au bassin de Thau</span>
        </div>
      </div>
      <div id="graph" class="graph-canvas"></div>
      <div class="legend"><span><span class="new"></span>concept construit</span><span><span class="known"></span>à découvrir</span></div>
    </aside>
  </section>

  <section class="card feedback" id="feedback" hidden>
    <div class="feedback-top">
      <div class="eyebrow">Feedback</div>
      <div id="comprehension" class="comprehension" aria-live="polite">
        <span class="comprehension-ring"><span id="comprehensionValue">0</span></span>
        <span><strong>Niveau de compréhension</strong><small id="comprehensionLabel">En construction</small></span>
      </div>
    </div>

    <div class="answer-reveal" id="answerReveal"></div>

    <div class="feedback-body">
      <h2 id="feedbackTitle"></h2>
      <p id="feedbackText" style="color:var(--mut);font-size:14.5px"></p>
    </div>

    <div class="concepts">
      <strong>Concepts associés</strong>
      <div id="conceptList"></div>
    </div>

    <div class="connection-stage" aria-label="Connexions conceptuelles">
      <div class="connection-pop"><span class="pop-label">Ce que cela relie</span><span id="previous"></span></div>
      <div class="connection-line"></div>
      <div class="connection-pop"><span class="pop-label">Ce que cela prépare</span><span id="next"></span></div>
    </div>

    <button id="continue" class="continue">Continuer <span>→</span></button>
  </section>

  <section class="card assessment" id="assessment" hidden>
    <div class="eyebrow">Transfert</div>
    <h2>Explique le système</h2>
    <p id="transfer-question" style="color:var(--mut);font-size:14.5px"></p>
    <textarea id="answer" placeholder="Ton explication, avec tes propres mots..."></textarea>
    <button id="finish">Terminer le PoC</button>
    <div id="result" class="result"></div>
  </section>

  <footer>
    Généré depuis <code>data/climat/el-nino-2026/el-nino-godzilla-2026.json</code> ·
    sources : vidéo LIMIT « EL NIÑO : GODZILLA » (11/10/2026, Vinz × Xavier Fettweis — ULiège), errata 24/09/2026, synthèse stratégique, Météo-France, SMBT ·
    <a href="index.html">← Learning Engine</a>
  </footer>
</div>

<script type="application/json" id="elnino-data">__ELNINO_DATA__</script>
<script>
"use strict";
const D=JSON.parse(document.getElementById('elnino-data').textContent);
const L=D.learning;
const $=id=>document.getElementById(id);

let i=0,graph=new Set(),start=performance.now(),events=[],comprehension=0;

$('poc-title').textContent=L.title;
$('poc-subtitle').textContent=L.subtitle;
$('transfer-question').textContent=L.transfer_question;

function render(){
  const l=L.levels[i];
  $('level').textContent=`NIVEAU ${i+1} / ${L.levels.length}`;
  $('title').textContent=l.title;
  $('situation').textContent=l.situation;
  $('problem').textContent=l.problem;
  $('choices').innerHTML=l.choices.map((c,n)=>`<button data-n="${n}">${String.fromCharCode(65+n)}. ${c[0]}</button>`).join('');
  document.querySelectorAll('#choices button').forEach(b=>b.onclick=()=>feedback(+b.dataset.n));
  $('feedback').hidden=true;
  $('assessment').hidden=true;
  $('progress').textContent=`${Math.round(i/L.levels.length*100)} %`;
  $('level-src').textContent=l.concepts&&l.concepts.length?'Concepts visés : '+l.concepts.join(' · '):'';
  drawGraph();
}
function feedback(n){
  const l=L.levels[i],choice=l.choices[n],isCorrect=n===l.correct;
  l.concepts.forEach(c=>graph.add(c));
  events.push({level:l.id,choice:n,correct:isCorrect,time:Math.round(performance.now()-start)});
  comprehension=Math.min(100,comprehension+(isCorrect?10:4));
  const correctText=l.choices[l.correct][0];
  $('feedbackTitle').textContent=isCorrect?'Tu viens d’identifier le bon mécanisme.':'Ton choix révèle un piège classique.';
  $('feedbackText').textContent=choice[1];
  $('answerReveal').innerHTML=`<div class="answer-label">RÉPONSE</div><div class="answer-choice">${correctText}</div>`+
    (isCorrect?'<div class="answer-correct">Ton raisonnement correspond au mécanisme attendu.</div>'
              :`<div class="answer-correct">La réponse attendue est <strong>${correctText}</strong>. ${l.choices[l.correct][1]}</div>`);
  $('conceptList').innerHTML=l.concepts.map((c,k)=>`<span class="concept" style="animation-delay:${k*55}ms">${c}</span>`).join('');
  $('previous').textContent=l.previous;
  $('next').textContent=l.next;
  $('feedback').hidden=false;
  animateComprehension(comprehension);
  drawGraph(l.concepts);
  document.querySelectorAll('#choices button').forEach((b,bi)=>{b.disabled=true;if(bi===l.correct)b.classList.add('good');else if(bi===n)b.classList.add('bad');});
  $('feedback').scrollIntoView({behavior:'smooth',block:'nearest'});
}
function animateComprehension(value){
  const ring=$('comprehension').querySelector('.comprehension-ring'),num=$('comprehensionValue'),label=$('comprehensionLabel');
  const startValue=Number(num.textContent)||0,duration=650,t0=performance.now();
  (function tick(t){
    const p=Math.min(1,(t-t0)/duration),e=1-Math.pow(1-p,3),v=Math.round(startValue+(value-startValue)*e);
    num.textContent=v;
    ring.style.setProperty('--score',v+'%');
    label.textContent=v<30?'En construction':v<60?'Émergence':v<80?'Structuration':'Intégration';
    if(p<1)requestAnimationFrame(tick);
  })(t0);
}
$('continue').onclick=()=>{
  i++;
  if(i<L.levels.length){render();}
  else{
    $('feedback').hidden=true;
    $('assessment').hidden=false;
    $('progress').textContent='100 %';
    drawGraph();
    $('assessment').scrollIntoView({behavior:'smooth'});
  }
};
$('finish').onclick=()=>{
  const a=$('answer').value.trim().toLowerCase();
  const score=L.transfer_keywords.filter(k=>a.includes(k.toLowerCase())).length;
  try{localStorage.setItem('cognitorium-elnino-poc',JSON.stringify({events,graph:[...graph],transferScore:score,answer:a,comprehension}));}catch(e){/* stockage indisponible : le PoC reste utilisable */}
  $('result').innerHTML=`<strong>PoC terminé.</strong><br>
    Concepts construits : ${graph.size} / ${L.concepts_graph.length}.<br>
    Compréhension finale : ${comprehension}/100.<br>
    Indice lexical de transfert : ${score}/${L.transfer_keywords.length}.<br>
    <small>Les données sont conservées localement (navigateur).</small><br><br>
    → Pour aller plus loin : module Atlas Frontignan « El Niño × Thau » (frise opérationnelle, simulation, quiz) et dataset <code>data/climat/el-nino-2026/</code>.`;
};
function drawGraph(newConcepts=[]){
  const all=L.concepts_graph;
  $('graph').innerHTML=all.map(c=>{
    const disc=graph.has(c);
    return `<span class="node ${disc?'discovered':''} ${newConcepts.includes(c)?'active':''}">${c}<small>${disc?'concept construit':'à découvrir'}</small></span>`;
  }).join('');
  $('graphCount').textContent=`${graph.size} concept${graph.size>1?'s':''}`;
}
render();
</script>
</body>
</html>
