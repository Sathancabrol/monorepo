# Token du bot Discord (jamais committer le vrai .env)
DISCORD_TOKEN=

# Nom du serveur (cosmétique, logs)
BONE_GUILD=Olympus

# 1 = Bone peut parler dans les salons listés sans mention
# 0 = mention / !bone / réponse uniquement
BONE_CHATTY=1

# Salons où Bone est bavard (sans #)
BONE_CHANNELS=général,general,olympus,bone,chat,lounge
