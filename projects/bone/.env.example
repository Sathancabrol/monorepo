# Token du bot Discord (jamais committer le vrai .env)
DISCORD_TOKEN=

# Nom du serveur (cosmétique, logs)
BONE_GUILD=Olympus

# 1 = Bone peut parler dans les salons listés sans mention
# 0 = mention / !bone / réponse uniquement
BONE_CHATTY=1

# Salons où Bone est bavard (sans #)
BONE_CHANNELS=général,general,olympus,bone,chat,lounge,accueil,welcome

# Intents privilégiés — à cocher AUSSI dans le Developer Portal (onglet Bot)
# puis relancer Bone. Menu PC : autorisations.bat option 2
BONE_MEMBERS_INTENT=0
BONE_PRESENCE_INTENT=0

# Connexions optionnelles (autorisations.bat option 3)
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_HOST=
