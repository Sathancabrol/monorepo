# Copy this file to .env. Never commit .env or paste its contents into chat.
# Discord Developer Portal > Bot > Reset Token. Keep the bot token private.
DISCORD_BOT_TOKEN=

# Required: server (guild) ID for Olympus. Use comma-separated IDs if needed.
ALLOWED_GUILD_IDS=
# Optional: limit commands to one or more private/test channels.
# Empty means all channels in ALLOWED_GUILD_IDS; prefer a dedicated test channel.
ALLOWED_CHANNEL_IDS=
# Required: your Discord user ID(s). Only these IDs may create shared memories.
OWNER_USER_IDS=

# Local SQLite database. Relative paths are resolved from this project directory.
DATABASE_PATH=data/laplace.sqlite3
# 30 days by default. Set to 0 to disable; existing archives are purged at startup and hourly.
ARCHIVE_RETENTION_DAYS=30
# Private slash-command replies prevent messages from appearing in a public channel.
PRIVATE_RESPONSES=true

# Local-first provider. Set LLM_MODEL to a model actually installed in Ollama.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=REPLACE_WITH_MODEL_FROM_OLLAMA_LIST

# Optional image analysis: leave VISION_MODEL blank to keep it disabled.
# Use a model actually installed in Ollama that supports image input.
VISION_PROVIDER=ollama
VISION_BASE_URL=http://127.0.0.1:11434/v1
VISION_API_KEY=ollama
VISION_MODEL=
# External image processing is blocked unless explicitly enabled below.
ALLOW_EXTERNAL_VISION=false

LLM_TIMEOUT_SECONDS=90
MAX_HISTORY_TURNS=6
MEMORY_TOP_K=5
