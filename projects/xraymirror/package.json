{
  "name": "xray-mirror-studio",
  "version": "0.7.0-exp.1",
  "private": true,
  "type": "module",
  "description": "X-Ray Mirror Studio — socle expérimental local-first : perception webcam, bus d'événements, plugins et overlays anatomiques",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc --noEmit && vite build --base=./",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare:wasm": "node scripts/sync-wasm.mjs",
    "verify:preview": "node scripts/verify-preview.mjs",
    "serve": "node scripts/serve-dev.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
